# Optional. The sync API ships with the app, so same-origin is the
# default and this can stay empty. Set it only if you host the API
# somewhere other than the app (e.g. pointing local dev at production).
VITE_SYNC_ENDPOINT=

# Optional usage analytics (Umami — privacy-first, cookieless). Leave both
# empty and no analytics code loads at all. Set both to turn on the Usage
# analytics setting in Settings (on by default); even then, nothing is sent
# if the user opts out or Do Not Track is on. VITE_UMAMI_SRC is the tracker
# script URL (e.g. https://cloud.umami.is/script.js) and VITE_UMAMI_WEBSITE_ID
# is the site id.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
